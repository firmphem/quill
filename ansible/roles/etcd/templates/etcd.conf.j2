[Member]
ETCD_DATA_DIR="/var/lib/etcd/patroni_cluster"
ETCD_LISTEN_PEER_URLS="http://{{ hostvars[inventory_hostname]['server_local_ip'] }}:2380,http://127.0.0.1:2380"
ETCD_LISTEN_CLIENT_URLS="http://{{ hostvars[inventory_hostname]['server_local_ip'] }}:2379,http://127.0.0.1:2379"
ETCD_NAME="{{ hostvars[inventory_hostname]['etcd_name'] }}"

[Clustering]
ETCD_INITIAL_ADVERTISE_PEER_URLS="http://{{ hostvars[inventory_hostname]['server_local_ip'] }}:2380"
ETCD_ADVERTISE_CLIENT_URLS="http://{{ hostvars[inventory_hostname]['server_local_ip'] }}:2379"
ETCD_INITIAL_CLUSTER="{% for host in groups['postgresql'] %}{{ hostvars[host]['etcd_name'] }}=http://{{ hostvars[host]['server_local_ip'] }}:2380{% if not loop.last %},{% endif %}{% endfor %}"
ETCD_INITIAL_CLUSTER_TOKEN="etcd-cluster"
ETCD_INITIAL_CLUSTER_STATE="new"
