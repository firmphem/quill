vrrp_script chk_haproxy {
    script "pidof haproxy"           
    interval 2                       
    weight -10                       
}

vrrp_script chk_patroni {
    script "/etc/keepalived/keepalived.sh"           
    interval 2                       
    weight -10                       
}

vrrp_instance VI_1 {
    state {{ keepalied_state }}
    interface {{ keepalived_interface }}                   
    virtual_router_id 51             
    priority {{ keepalied_weight }}                     
    advert_int 1                    
    virtual_ipaddress {
        {{ keepalived_floating_ip }}                # Floating IP
    }
    track_script {
        chk_patroni
    }
}

